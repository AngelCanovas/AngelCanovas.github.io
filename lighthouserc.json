{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4322/",
        "http://127.0.0.1:4322/es/",
        "http://127.0.0.1:4322/cv/",
        "http://127.0.0.1:4322/cv/es/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "emulatedUserAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36 Chrome-Lighthouse"
      },
      "startServerCommand": "node scripts/serve-dist.mjs --port 4322",
      "startServerReadyPattern": "serving"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 300
          }
        ],
        "speed-index": [
          "warn",
          {
            "maxNumericValue": 3000
          }
        ],
        "resource-summary:document:size": [
          "warn",
          {
            "maxNumericValue": 175000
          }
        ],
        "resource-summary:stylesheet:size": [
          "warn",
          {
            "maxNumericValue": 62000
          }
        ],
        "resource-summary:script:size": [
          "warn",
          {
            "maxNumericValue": 38000
          }
        ],
        "resource-summary:font:size": [
          "warn",
          {
            "maxNumericValue": 78000
          }
        ],
        "resource-summary:total:size": [
          "warn",
          {
            "maxNumericValue": 400000
          }
        ],
        "resource-summary:total:count": [
          "warn",
          {
            "maxNumericValue": 52
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
