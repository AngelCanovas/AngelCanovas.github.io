---
import { withBase } from '../lib/base-path';
import { personal } from '../data/site';
import PeriodRange from './PeriodRange.astro';
import { getContent, type Lang } from '../lib/i18n';
import { splitPeriod } from '../lib/format';
import { cvPageHref, cvPdfHref, cvTextHref, homeHref } from '../lib/routes';
import { emailParts, obfuscateEmail } from '../lib/security';
import { siteHost } from '../lib/site-url';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);
const { about, resume, skills } = c;
const { user: emailUser, domain: emailDomain } = emailParts();
const emailHtml = obfuscateEmail();

const labels = {
  ...c.cv,
};
const switchLinks = (['en', 'es', 'fr'] as const).map((code) => ({
  code,
  href: cvPageHref(code),
  active: code === lang,
  label: code.toUpperCase(),
  aria: `${code.toUpperCase()} — ${code === 'en' ? 'English' : code === 'es' ? 'Español' : 'Français'}`,
}));

const jobs = resume.experience.map((job) => ({ ...job, period: splitPeriod(job.period) }));
const studies = resume.education.map((edu) => ({ ...edu, period: splitPeriod(edu.period) }));
---

<article class="cv-doc" itemscope itemtype="https://schema.org/Person">
  <nav class="cv-nav">
    <a href={homeHref(lang)} class="cv-back" data-astro-prefetch>
      {labels.back}
    </a>
    <span class="cv-nav-actions">
      <a href={cvPdfHref(lang)} download>
        {labels.download}
      </a>
      <button type="button" class="cv-generate" data-print-cv>
        {labels.generate}
      </button>
      <button
        type="button"
        class="cv-copy"
        data-copy-cv
        data-cv-url={cvTextHref(lang)}
        data-label-copied={labels.copied}
        data-label-failed={labels.copyFailed}
      >
        {labels.copy}
      </button>
      <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
      <span class="cv-lang-switch" role="group" aria-label={c.nav.languageLabel}>
        {switchLinks.map((link) => (
          <a
            href={link.href}
            hreflang={link.code}
            data-set-standalone-lang={link.code}
            data-astro-prefetch
            class:list={['cv-lang-option', { active: link.active }]}
            aria-current={link.active ? 'page' : undefined}
            aria-label={link.aria}
          >
            {link.label}
          </a>
        ))}
      </span>
    </span>
  </nav>

  <header class="cv-head">
    <h1 itemprop="name">{personal.fullName}</h1>
    <p class="cv-role" itemprop="jobTitle">
      {about.role} — {about.workModel}
    </p>
    <ul class="cv-contact" role="list">
      <li>
        <a
          href={withBase('/#contact')}
          itemprop="email"
          data-email-link
          data-email-user={emailUser}
          data-email-domain={emailDomain}
          set:html={emailHtml}
        />
      </li>
      <li>
        <a href={personal.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn
          <span class="visually-hidden"> {c.ui.newTab}</span>
        </a>
      </li>
      <li>
        <a href={personal.github} target="_blank" rel="noopener noreferrer">
          github.com/{personal.githubHandle}
          <span class="visually-hidden"> {c.ui.newTab}</span>
        </a>
      </li>
      <li>
        <span itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
          <span itemprop="addressLocality">{about.location}</span>
        </span>
      </li>
    </ul>
  </header>

  <section class="cv-section">
    <h2>{labels.summary}</h2>
    <p>{about.summary}</p>
    <p>{about.secureSummary}</p>
    <p>{about.languages}</p>
  </section>

  <section class="cv-section cv-highlights">
    <h2>{labels.highlightsTitle}</h2>
    <p class="cv-impact">{labels.impactLine}</p>
    <ul>
      {labels.highlights.map((highlight) => (
        <li>{highlight}</li>
      ))}
    </ul>
  </section>

  <section class="cv-section">
    <h2>{resume.experienceTitle}</h2>
    {jobs.map((job) => (
      <div class="cv-job">
        <h3>
          {job.title}{' '}
          <span class="cv-company">
            · {job.company}, {job.location}
          </span>
        </h3>
        <p class="cv-period">
          <PeriodRange period={job.period} />
        </p>
        {job.context && <p class="cv-context">{job.context}</p>}
        <ul>
          {job.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        {job.stack.length > 0 && (
          <p class="cv-stack">
            <strong>{c.cv.stack}:</strong> {job.stack.join(', ')}
          </p>
        )}
        {job.assignments.map((assignment) => (
          <div class="cv-assignment">
            <p class="cv-assignment-title">{assignment.title}</p>
            <ul>
              {assignment.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}
  </section>

  <section class="cv-section">
    <h2>{skills.title}</h2>
    {skills.groups.map((group) => (
      <p class="cv-skill-group">
        <strong>{group.title}:</strong> {group.skills.join(' · ')}
      </p>
    ))}
  </section>

  <section class="cv-section">
    <h2>{resume.educationTitle}</h2>
    {studies.map((edu) => (
      <div class="cv-entry">
        <h3>{edu.degree}</h3>
        <p class="cv-period">
          {edu.period.start && (
            <>
              <PeriodRange period={edu.period} />
              <span class="cv-company"> · </span>
            </>
          )}
          <span class="cv-company">{edu.school}</span>
        </p>
        {edu.detail && <p>{edu.detail}</p>}
      </div>
    ))}
  </section>

  <section class="cv-section">
    <h2>{resume.certificationsTitle}</h2>
    <ul>
      {resume.certifications.map((cert) => (
        <li>{cert}</li>
      ))}
    </ul>
  </section>

  <section class="cv-section">
    <h2>{resume.languagesTitle}</h2>
    <ul>
      {resume.languages.map((item) => (
        <li>
          <strong>{item.language}:</strong> {item.level}
        </li>
      ))}
    </ul>
  </section>

  <section class="cv-section">
    <h2>{about.homeLab.title}</h2>
    <p>{about.homeLab.intro}</p>
    <ul>
      {about.homeLab.points.map((point) => (
        <li>{point}</li>
      ))}
    </ul>
  </section>

  <footer class="cv-foot">
    <p>
      {personal.fullName} · {labels.updated} · {siteHost}
    </p>
  </footer>
</article>

<script>
  import { initCvPrint } from '../scripts/cv-print';
  import { initCvCopy } from '../scripts/cv-copy';
  import { initStandaloneLanguageSwitch } from '../scripts/navigation';
  import { safeInit } from '../scripts/safe-init';

  safeInit(initStandaloneLanguageSwitch);
  safeInit(initCvPrint);
  safeInit(initCvCopy);
</script>

<style>
  .cv-doc {
    /* 45–75 characters per line for on-screen reading; print stays full width. */
    max-width: 660px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    color: #1c1f23;
    background: #ffffff;
    line-height: 1.6;
  }
  .cv-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid #d9dee3;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cv-nav-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .cv-generate {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: #963d28;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor, transparent 60%);
    text-underline-offset: 3px;
  }
  .cv-generate:hover {
    text-decoration-color: currentColor;
  }
  .cv-copy {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: #963d28;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor, transparent 60%);
    text-underline-offset: 3px;
  }
  .cv-copy:hover {
    text-decoration-color: currentColor;
  }
  .cv-copy:disabled {
    cursor: wait;
    opacity: 0.7;
  }
  .cv-lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding-left: 0.4rem;
    border-left: 1px solid #d9dee3;
  }
  .cv-lang-option {
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    color: #52606d;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .cv-lang-option:hover,
  .cv-lang-option.active {
    color: #963d28;
    background: #f4ece7;
  }
  .cv-highlights ul {
    margin-bottom: 0;
  }
  .cv-impact {
    margin: 0 0 0.5rem;
    padding: 0.45rem 0.6rem;
    border-left: 3px solid var(--accent-color);
    background: var(--panel-color);
    color: var(--heading-color);
    font-weight: 600;
    font-size: 0.84rem;
    line-height: 1.45;
  }
  .cv-highlights li {
    margin-bottom: 0.35rem;
  }
  .cv-head {
    margin-bottom: 1.5rem;
  }
  .cv-head h1 {
    font-size: 2rem;
    margin: 0 0 0.25rem;
    color: #050d18;
  }
  .cv-role {
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .cv-contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    font-size: 0.92rem;
  }
  .cv-section {
    margin-top: 2rem;
  }
  .cv-section h2 {
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #050d18;
    border-bottom: 2px solid #963d28;
    padding-bottom: 0.35rem;
    margin-bottom: 0.9rem;
  }
  .cv-job,
  .cv-entry {
    margin-bottom: 1.35rem;
    break-inside: avoid;
  }
  .cv-job h3,
  .cv-entry h3 {
    font-size: 1.02rem;
    margin: 0;
    color: #050d18;
  }
  .cv-company {
    font-weight: 500;
    color: #4a5158;
  }
  .cv-period {
    font-size: 0.88rem;
    color: #4a5158;
    margin: 0.15rem 0 0.5rem;
  }
  .cv-context {
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .cv-stack,
  .cv-skill-group {
    font-size: 0.92rem;
    margin: 0.6rem 0 0;
  }
  .cv-assignment {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    background: #f6f3eb;
    border-left: 3px solid #963d28;
  }
  .cv-assignment-title {
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .cv-doc ul {
    margin: 0.35rem 0 0;
    padding-left: 1.25rem;
  }
  .cv-doc ul li {
    margin-bottom: 0.3rem;
  }
  .cv-foot {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid #d9dee3;
    font-size: 0.82rem;
    color: #6b7278;
  }
  @media (max-width: 575px) {
    .cv-doc {
      padding: 1.5rem 1rem 3rem;
    }
  }
  @media screen {
    .cv-doc {
      max-width: 820px;
      padding: 3rem 2rem 4rem;
      border-inline: 1px solid #cbc7b8;
    }
    .cv-head h1 {
      font-size: clamp(2.3rem, 5vw, 3.6rem);
      letter-spacing: -0.055em;
      line-height: 1.05;
      margin-bottom: 1rem;
    }
    .cv-section h2 {
      text-transform: none;
      letter-spacing: -0.02em;
      font-size: 1.5rem;
      border-bottom-width: 1px;
      padding-bottom: 0.6rem;
    }
  }
  @media screen and (max-width: 575px) {
    .cv-doc {
      padding: 1.5rem 1.25rem 3rem;
      border: 0;
    }
  }
  @media print {
    .cv-nav {
      display: none;
    }
    .cv-doc {
      max-width: none;
      padding: 0;
      font-size: 9.1pt;
      line-height: 1.3;
    }
    /* Global `section` padding is for the marketing page, not the CV sheet. */
    .cv-doc section {
      padding-block: 0;
    }
    .cv-head {
      margin-bottom: 0.85rem;
    }
    .cv-head h1 {
      font-size: 21pt;
    }
    .cv-section {
      margin-top: 0.85rem;
    }
    .cv-section h2 {
      font-size: 10pt;
      margin-bottom: 0.35rem;
      padding-bottom: 0.15rem;
    }
    .cv-job,
    .cv-entry {
      margin-bottom: 0.55rem;
    }
    .cv-doc ul {
      margin-top: 0.15rem;
    }
    .cv-doc ul li {
      margin-bottom: 0.08rem;
    }
    .cv-highlights {
      margin-top: 0.65rem;
    }
    .cv-impact {
      margin-bottom: 0.3rem;
      padding: 0.3rem 0.45rem;
      font-size: 8.5pt;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .cv-foot {
      display: none;
    }
  }
</style>
