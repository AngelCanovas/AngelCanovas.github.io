---
import Icon from './Icon.astro';
import { personal } from '../data/site';
import { getContent, type Lang } from '../lib/i18n';
import { cvPdfHref } from '../lib/routes';
import { safeJson } from '../lib/security';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = getContent(lang);
---

<section id="hero" class="hero section">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-backdrop-drift" data-hero-drift data-editorial-depth>
      <canvas id="hero-canvas" class="hero-canvas"></canvas>
    </div>
  </div>
  <div class="hero-atmosphere" aria-hidden="true" data-editorial-depth></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-content">
    <div class="hero-availability">
      <span class="hero-availability-dot" aria-hidden="true"></span>
      <span>{t.hero.availability}</span>
    </div>
    <p class="hero-eyebrow">{t.hero.eyebrow}</p>
    <h1 class="hero-name">{personal.fullName}</h1>
    <p class="hero-role">
      <span class="hero-role-stack" aria-hidden="true">
        <span class="hero-role-active">
          <span class="typed" data-typed-items={safeJson(t.hero.roles)}>
            {t.hero.roles[0]}
          </span>
          <span class="typed-cursor typed-cursor--blink"></span>
        </span>
        {t.hero.roles.map((role) => (
          <span class="hero-role-size">
            {role}
            <span class="typed-cursor" />
          </span>
        ))}
      </span>
      <span class="visually-hidden">{t.hero.roles.join(' · ')}</span>
    </p>
    <p class="hero-subtitle mt-3">{t.hero.headline}</p>
    <div class="hero-actions mt-4">
      <a href="#contact" class="hero-btn hero-btn--primary me-2 mb-2">
        {t.hero.ctaContact}
      </a>
      <a href="#resume" class="hero-btn hero-btn--ghost me-2 mb-2">
        {t.hero.ctaResume}
      </a>
      <a href={cvPdfHref(lang)} class="hero-btn hero-btn--ghost mb-2" download>
        <Icon name="download" class="me-1" />
        {t.hero.ctaCv}
      </a>
    </div>
  </div>
</section>

<script>
  import { initHeroBackdrop } from '../scripts/hero-backdrop';
  import { safeInit } from '../scripts/safe-init';
  import { initTypedText } from '../scripts/typed-text';

  safeInit(() => {
    const root = document.getElementById('hero');
    const canvas = document.getElementById('hero-canvas');
    if (root && canvas instanceof HTMLCanvasElement) initHeroBackdrop(root, canvas);
  });
  safeInit(() => {
    const typed = document.querySelector<HTMLElement>('.typed');
    if (typed) initTypedText(typed);
  });
</script>

<style>
  .hero-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: linear-gradient(90deg, transparent 32%, #000 74%);
  }
  .hero-backdrop-drift {
    position: absolute;
    inset: -20px;
  }
  .hero-canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    color: var(--hero-labels-ink);
    outline-color: var(--accent-ink);
    font-family: var(--default-font);
  }
  .hero-canvas[data-ready] {
    opacity: 0.65;
  }
  .hero-atmosphere {
    position: absolute;
    right: -8%;
    top: 14%;
    width: 48%;
    height: 74%;
    pointer-events: none;
  }
  .hero-atmosphere::before,
  .hero-atmosphere::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .hero-atmosphere::before {
    background: radial-gradient(light-dark(#a4422b, #e5a086) 0.8px, transparent 1px) 0 0 / 6px 6px;
    clip-path: polygon(30% 0, 100% 0, 70% 100%, 0 100%);
    opacity: 1;
  }
  .hero-atmosphere::after {
    inset: 16% 10% 8% -10%;
    background: radial-gradient(light-dark(#787d67, #aeb39a) 0.65px, transparent 1px) 0 0 / 5px 5px;
    clip-path: polygon(0 0, 72% 0, 100% 100%, 28% 100%);
    opacity: 1;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, var(--background-color) 12%, transparent 85%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero-availability {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--default-color);
    padding-bottom: 1rem;
    margin-bottom: clamp(2rem, 6vh, 4rem);
    border-bottom: 1px solid var(--rule-color);
    max-width: 30rem;
  }
  .hero-availability-dot {
    width: 7px;
    height: 7px;
    background: var(--accent-ink);
  }
  .hero-eyebrow {
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 1rem;
    color: var(--accent-ink);
  }
  .hero-name {
    max-width: 9ch;
    margin: 0;
    font-size: clamp(3.8rem, 7.6vw, 7.2rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }
  .hero-role {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    margin: 2rem 0 0;
    max-width: 33rem;
    font-weight: 500;
  }
  .hero-role-stack {
    display: grid;
  }
  .hero-role-active,
  .hero-role-size {
    grid-area: 1 / 1;
  }
  .hero-role-size {
    visibility: hidden;
  }
  .typed-cursor {
    display: inline-block;
    width: 0.6ch;
    color: var(--accent-ink);
  }
  .typed-cursor::after {
    content: '|';
  }
  .hero-subtitle {
    max-width: 31rem;
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 0;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    max-width: 36rem;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.65rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius-control);
    border: 1px solid var(--rule-color);
    color: var(--heading-color);
    background: var(--background-color);
  }
  .hero-btn--primary {
    color: var(--contrast-color);
    background: var(--accent-fill);
    border-color: var(--accent-fill);
  }
  .hero-btn:hover {
    color: var(--contrast-color);
    background: var(--accent-fill);
    border-color: var(--accent-fill);
  }
  @media (max-width: 767px) {
    .hero-name {
      font-size: clamp(3.3rem, 13vw, 5rem);
    }
    .hero-atmosphere {
      top: auto;
      bottom: -7%;
      right: -15%;
      height: 30%;
      width: 85%;
      opacity: 0.4;
    }
    .hero-backdrop {
      mask-image: linear-gradient(180deg, transparent 68%, #000);
    }
    .hero-glow {
      background: linear-gradient(180deg, transparent 55%, var(--background-color));
    }
    .hero-availability {
      margin-bottom: 2.5rem;
      max-width: calc(100% - 3rem);
    }
  }
  @media (hover: none), (pointer: coarse), (scripting: none) {
    .hero-backdrop {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-atmosphere::before {
      animation: ink-register-front 2.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero-atmosphere::after {
      animation: ink-register-back 3.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero[data-hero-paused] .hero-atmosphere::before,
    .hero[data-hero-paused] .hero-atmosphere::after {
      animation-play-state: paused;
    }
  }
  @keyframes ink-register-front {
    from {
      opacity: 0;
      transform: translate(18%, -7%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes ink-register-back {
    from {
      opacity: 0;
      transform: translate(-15%, 12%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media print {
    .hero-atmosphere {
      display: none;
    }
    .hero-name {
      max-width: none;
      font-size: 2.5rem;
    }
  }
</style>
