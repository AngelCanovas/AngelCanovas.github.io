---
import { withBase } from '../lib/base-path';
import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 16 16"
  class={className}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <use href={`${withBase('/sprite.svg')}#${name}`} />
</svg>

<style>
  svg {
    width: 1em;
    height: 1em;
    vertical-align: -0.125em;
    flex-shrink: 0;
  }
</style>
