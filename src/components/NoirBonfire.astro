<script>
  import { safeInit } from '../scripts/safe-init';

  function initNoirBonfireInteraction(): void {
    const hero = document.getElementById('hero');
    const artwork = document.querySelector<SVGElement>('[data-noir-bonfire]');
    if (!hero || !artwork) return;

    const pointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const properties = [
      '--noir-hover',
      '--noir-flame-x',
      '--noir-flame-y',
      '--noir-flame-scale',
      '--noir-glint-x',
    ];
    let frame = 0;
    let latest: { x: number; y: number } | null = null;

    const clear = () => {
      latest = null;
      cancelAnimationFrame(frame);
      frame = 0;
      properties.forEach((property) => artwork.style.removeProperty(property));
      delete artwork.dataset.noirHover;
    };

    const paint = () => {
      frame = 0;
      if (
        !latest ||
        document.documentElement.dataset.style !== 'noir' ||
        !pointer.matches ||
        motion.matches
      ) {
        clear();
        return;
      }

      const rect = artwork.getBoundingClientRect();
      const normalX = (latest.x - (rect.left + rect.width * 0.5)) / (rect.width * 0.5);
      const normalY = (latest.y - (rect.top + rect.height * 0.56)) / (rect.height * 0.56);
      const distance = Math.hypot(normalX, normalY);
      const intensity = Math.max(0, Math.min(1, 1 - distance));
      if (intensity < 0.08) {
        clear();
        return;
      }

      artwork.style.setProperty('--noir-hover', intensity.toFixed(3));
      artwork.style.setProperty('--noir-flame-x', `${(normalX * 13).toFixed(2)}px`);
      artwork.style.setProperty('--noir-flame-y', `${(-intensity * 7).toFixed(2)}px`);
      artwork.style.setProperty('--noir-flame-scale', (1 + intensity * 0.1).toFixed(3));
      artwork.style.setProperty('--noir-glint-x', `${(normalX * 5).toFixed(2)}px`);
      artwork.dataset.noirHover = 'true';
    };

    const move = (event: PointerEvent) => {
      if (
        event.pointerType === 'touch' ||
        !pointer.matches ||
        motion.matches ||
        document.documentElement.dataset.style !== 'noir'
      ) {
        clear();
        return;
      }
      latest = { x: event.clientX, y: event.clientY };
      if (!frame) frame = requestAnimationFrame(paint);
    };

    const styleObserver = new MutationObserver(clear);
    styleObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-style'],
    });
    pointer.addEventListener('change', clear);
    motion.addEventListener('change', clear);
    hero.addEventListener('pointermove', move, { passive: true });
    hero.addEventListener('pointerleave', clear);
    window.addEventListener('pagehide', clear, { once: true });
  }

  safeInit(initNoirBonfireInteraction);
</script>
