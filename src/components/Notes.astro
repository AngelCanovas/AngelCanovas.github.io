---
import SectionHeading from './SectionHeading.astro';
import { getContent, type Lang } from '../lib/i18n';
import { readingMinutes } from '../lib/format';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = getContent(lang).notes;
---

{t.enabled && t.items.length > 0 && (
  <section id="notes" class="notes section">
    <SectionHeading title={t.title} summary={t.subtitle} />

    <div class="container">
      <div class="row gy-4">
        {t.items.map((note, idx) => (
          <div class="col-lg-6 d-flex" data-aos="fade-up" data-aos-delay={(idx + 1) * 100}>
            <article class="note-card w-100 p-4 rounded-4">
              <h3 class="note-title mb-2">{note.title}</h3>
              <p class="note-meta mb-3">
                <span class="note-time">
                  {readingMinutes(note.body)} {t.readingTimeLabel}
                </span>
                {note.tags.map((tag) => (
                  <span class="note-tag">{tag}</span>
                ))}
              </p>
              {note.body.map((paragraph) => (
                <p class="note-text">{paragraph}</p>
              ))}
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .note-card {
    background: var(--surface-color);
    border: 1px solid color-mix(in srgb, var(--default-color), transparent 90%);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }
  .note-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.1);
    border-color: color-mix(in srgb, var(--accent-color), transparent 70%);
  }
  .note-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--heading-color);
    line-height: 1.3;
  }
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
  }
  .note-time {
    color: color-mix(in srgb, var(--default-color), transparent 40%);
    font-weight: 600;
  }
  .note-tag {
    padding: 0.15rem 0.55rem;
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--default-color), transparent 95%);
    color: color-mix(in srgb, var(--default-color), transparent 20%);
  }
  .note-text {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--default-color);
  }
  .note-text:last-child {
    margin-bottom: 0;
  }
</style>
