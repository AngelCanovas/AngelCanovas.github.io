---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { getContent, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const content = getContent(lang);
const t = content.portfolio;
const ui = content.ui;

const categoryIcons: Record<string, IconName> = {
  app: 'window-stack',
  security: 'shield-lock',
  infra: 'hdd-network',
  web: 'globe',
};
---

<section id="portfolio" class="portfolio section light-background">
  <SectionHeading title={t.title} summary={t.subtitle} />

  <div class="container" data-portfolio data-status-template={t.filterStatus}>
    <div class="portfolio-filters" role="group" aria-label={t.filtersLabel}>
      <button type="button" class="filter-btn filter-active" data-filter="*" aria-pressed="true">
        {t.allLabel}
      </button>
      {t.categories.map((cat) => (
        <button type="button" class="filter-btn" data-filter={cat.key} aria-pressed="false">
          {cat.label}
        </button>
      ))}
    </div>

    <p class="visually-hidden" role="status" data-portfolio-status></p>

    <div class="row gy-4 portfolio-grid">
      {t.projects.map((project) => (
        <div class="col-lg-4 col-md-6 portfolio-item" data-category={project.category}>
          <article
            class:list={[
              'portfolio-card card h-100 p-4 d-flex flex-column',
              project.featured && 'is-featured',
              project.link && 'has-link',
            ]}
          >
            <div class="portfolio-card-top d-flex align-items-start justify-content-between mb-3">
              <div class="portfolio-icon">
                <Icon name={categoryIcons[project.category] ?? 'folder'} />
              </div>
              {project.featured && <span class="portfolio-featured">{t.featuredLabel}</span>}
            </div>
            <span class="portfolio-category mb-2">
              {t.categoryLabels[project.category] ?? project.category}
            </span>
            <h3 class="portfolio-card-title mb-2">{project.title}</h3>
            <p class="portfolio-desc">{project.description}</p>
            <div class="portfolio-tags d-flex flex-wrap gap-2 mt-3">
              {project.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
            <div class="portfolio-actions mt-auto pt-3">
              {project.caseStudy && (
                <details class="portfolio-case">
                  <summary aria-label={`${t.caseStudyLabel}: ${project.title}`}>
                    {t.caseStudyLabel}
                  </summary>
                  <dl class="portfolio-case-body mb-0">
                    <dt>{t.caseStudyProblem}</dt>
                    <dd>{project.caseStudy.problem}</dd>
                    <dt>{t.caseStudyApproach}</dt>
                    <dd>{project.caseStudy.approach}</dd>
                    <dt>{t.caseStudyImpact}</dt>
                    <dd>{project.caseStudy.impact}</dd>
                  </dl>
                </details>
              )}
              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="portfolio-external"
                >
                  {t.viewProject}
                  <Icon name="box-arrow-up-right" />
                  <span class="visually-hidden">
                    {project.title} {ui.newTab}
                  </span>
                </a>
              )}
            </div>
          </article>
        </div>
      ))}
      <p class="portfolio-empty" data-portfolio-empty hidden>
        {t.empty}
      </p>
    </div>
  </div>
</section>

<script>
  import { initPortfolioFilter } from '../scripts/portfolio-filter';
  import { safeInit } from '../scripts/safe-init';

  const root = document.querySelector<HTMLElement>('[data-portfolio]');
  safeInit(() => {
    if (root) initPortfolioFilter(root);
  });
</script>

<style>
  .portfolio-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 auto 2rem;
    padding: 0;
  }
  .filter-btn {
    border: 1px solid color-mix(in srgb, var(--default-color), transparent 85%);
    background: var(--surface-color);
    color: var(--default-color);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-control);
    cursor: pointer;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .filter-btn:hover {
    color: var(--accent-ink);
    border-color: color-mix(in srgb, var(--accent-ink), transparent 55%);
    transform: translateY(-1px);
  }
  .filter-btn.filter-active {
    color: var(--contrast-color);
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--accent-fill), transparent 65%);
  }

  .portfolio-item.is-hidden {
    display: none;
  }
  .portfolio-item:not(.is-hidden) .portfolio-card {
    animation: portfolio-fade 0.4s ease both;
  }
  @keyframes portfolio-fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .portfolio-card {
    position: relative;
    overflow: hidden;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }
  .portfolio-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--accent-color),
      color-mix(in srgb, var(--accent-color), transparent 70%)
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
  }
  /* Only cards with an outbound link behave like links. */
  .portfolio-card.has-link:hover,
  .portfolio-card.has-link:focus-within {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent-color), transparent 60%);
  }
  .portfolio-card.has-link:hover::before,
  .portfolio-card.has-link:focus-within::before {
    transform: scaleX(1);
  }
  .portfolio-card.is-featured {
    border-color: color-mix(in srgb, var(--accent-color), transparent 75%);
  }
  .portfolio-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent-color), transparent 90%);
    color: var(--accent-color);
    font-size: 1.5rem;
  }
  .portfolio-featured {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-ink);
    background: color-mix(in srgb, var(--accent-ink), transparent 90%);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-control);
  }
  .portfolio-category {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-ink);
  }
  .portfolio-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--heading-color);
  }
  .portfolio-desc {
    font-size: 0.92rem;
    color: var(--default-color);
    margin-bottom: 0;
    line-height: 1.6;
  }
  /* Actions pinned to the bottom of every card so the foot aligns across a row. */
  .portfolio-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    border-top: 1px dashed color-mix(in srgb, var(--default-color), transparent 85%);
  }
  .portfolio-case {
    font-size: 0.85rem;
  }
  .portfolio-case > summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent-ink);
    list-style-position: inside;
  }
  .portfolio-case > summary::marker {
    color: var(--accent-ink);
  }
  .portfolio-case-body {
    margin-top: 0.6rem;
  }
  .portfolio-case-body dt {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--default-color), transparent 25%);
  }
  .portfolio-case-body dd {
    margin: 0 0 0.5rem;
    line-height: 1.55;
  }
  /* The outbound link is a different kind of action: it leaves the page, so it
     is separated from the disclosure and keeps the external-arrow affordance. */
  .portfolio-external {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .portfolio-external:hover {
    text-decoration: underline;
  }
  .portfolio-empty {
    text-align: center;
    color: color-mix(in srgb, var(--default-color), transparent 25%);
    margin: 1rem 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-item:not(.is-hidden) .portfolio-card {
      animation: none;
    }
    .portfolio-card,
    .portfolio-card::before,
    .filter-btn {
      transition: none;
    }
  }
</style>
