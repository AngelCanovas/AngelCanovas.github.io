---
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Skills from '../components/Skills.astro';
import Resume from '../components/Resume.astro';
import Portfolio from '../components/Portfolio.astro';
import Services from '../components/Services.astro';
import Notes from '../components/Notes.astro';
import Contact from '../components/Contact.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
import { personal } from '../data/site';
import { buildWebSiteSchema } from '../lib/structured-data';
import { safeJson } from '../lib/security';
import { siteUrl } from '../lib/site-url';
import { getContent, type Lang } from '../lib/i18n';
import { getStyleLabels } from '../lib/style-labels';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = getContent(lang).ui;
const styleLabels = getStyleLabels(lang);
const websiteSchema = buildWebSiteSchema({ url: `${siteUrl}/`, name: personal.fullName });
---

<Layout lang={lang} profile>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={safeJson(websiteSchema)}
  ></script>
  <script>
    import { initLanguageDetection } from '../scripts/language-detection';
    import { initPortfolio } from '../scripts/portfolio';
    import { initMobileNav } from '../scripts/mobile-nav';
    import { initStyleToggle } from '../scripts/style';
    import { initThemeToggle } from '../scripts/theme';
    import { safeInit } from '../scripts/safe-init';

    safeInit(initLanguageDetection);
    initPortfolio();

    // ClientRouter swaps the page body; re-arm the controls that live in the
    // new DOM. Each initializer is guarded so the first page is unaffected.
    const routerKey = '__angelPortfolioRouterHook';
    const globalWindow = window as unknown as Record<string, unknown>;
    if (!globalWindow[routerKey]) {
      globalWindow[routerKey] = true;
      document.addEventListener('astro:after-swap', () => {
        safeInit(initThemeToggle);
        safeInit(initStyleToggle);
        safeInit(initMobileNav);
      });
    }
  </script>
  <Header lang={lang} />
  <div id="mobile-nav-overlay" class="mobile-nav-overlay d-xl-none" aria-hidden="true"></div>
  <main id="main-content" class="main" tabindex="-1">
    <div
      class="style-progress-backdrop"
      data-style-progress
      data-style-progress-backdrop
      data-hero-visible="true"
      data-label-running={styleLabels.running}
      data-label-paused={styleLabels.paused}
    >
      <canvas class="style-progress-canvas" data-style-progress-canvas aria-hidden="true"></canvas>
      <div class="style-progress-tube" data-style-progress-tube>
        <canvas class="style-progress-tube-canvas" data-style-progress-tube-canvas></canvas>
        <button
          type="button"
          class="style-progress-backdrop-control"
          data-style-progress-control
          aria-label={styleLabels.running}
          aria-pressed="false"
        >
          <span class="visually-hidden">{styleLabels.running}</span>
        </button>
      </div>
      <span
        class="visually-hidden"
        data-style-progress-track
        role="progressbar"
        aria-label={styleLabels.progress}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      ></span>
    </div>
    <Hero lang={lang} />
    <About lang={lang} />
    <SelectedWork lang={lang} />
    <Skills lang={lang} />
    <Resume lang={lang} />
    <Portfolio lang={lang} />
    <Services lang={lang} />
    <Notes lang={lang} />
    <Contact lang={lang} />
    <Quote lang={lang} />
  </main>

  <Footer lang={lang} />

  <!-- Scroll Top -->
  <a
    href="#"
    id="scroll-top"
    class="scroll-top d-flex align-items-center justify-content-center"
    aria-label={ui.scrollTop}
  >
    <Icon name="arrow-up-short" />
  </a>
</Layout>
